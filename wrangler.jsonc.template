{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Boolean form (not the newer per-path array form) so this config stays
    // parseable by @cloudflare/vitest-pool-workers' internally bundled
    // wrangler, which lags behind the top-level wrangler dependency. The
    // Worker now explicitly falls back to ASSETS for unmatched GET routes
    // (see the catch-all in src/index.ts) instead of relying on wrangler to
    // route non-API paths to assets automatically.
    "run_worker_first": true
  },
__ROUTES_BLOCK__
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__DB_NAME__",
      "database_id": "__DB_ID__",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "DOMAIN": "__DOMAIN_VALUE__",
    "ISSUE_START_DATE": "2000-01-01",
    "ISSUE_END_DATE": "2099-12-31",
    "MAX_TICKETS": "__MAX_TICKETS__"
  }

  // secrets (set via `wrangler secret put`, not committed):
  //   JWT_SECRET
}
