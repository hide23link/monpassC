{
  // これはwrangler.jsoncの雛形(テンプレート)であり、そのままでは使えない。
  // __WORKER_NAME__のようなプレースホルダーは`scripts/render-wrangler-config.mjs`
  // (setup.shが内部で呼ぶ)が実際の値に置き換え、リポジトリ直下に`wrangler.jsonc`
  // を生成する。フォーク先ごとに固有の値(Worker名・D1のIDなど)が入るため、
  // このテンプレート自体には特定の環境の情報は一切含まれない。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // bool形式を採用している(パスごとの配列形式という新しいwranglerの機能では
    // ない)。理由: @cloudflare/vitest-pool-workersが内部にバンドルしている
    // wranglerのバージョンが最新に追いついておらず、配列形式だとパースに失敗する
    // ため。その代わり、APIにマッチしなかったGETリクエストをASSETSへ明示的に
    // フォールバックする処理をsrc/index.tsのcatch-allルートで実装しており、
    // wrangler側の自動振り分けには頼っていない。
    "run_worker_first": true
  },
__ROUTES_BLOCK__
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__DB_NAME__",
      "database_id": "__DB_ID__",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "DOMAIN": "__DOMAIN_VALUE__",
    "ISSUE_START_DATE": "2000-01-01",
    "ISSUE_END_DATE": "2099-12-31",
    "MAX_TICKETS": "__MAX_TICKETS__"
  }

  // secrets (set via `wrangler secret put`, not committed):
  //   JWT_SECRET
}
