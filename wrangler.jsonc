{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monpassc",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Boolean form (not the newer per-path array form) so this config stays
    // parseable by @cloudflare/vitest-pool-workers' internally bundled
    // wrangler, which lags behind the top-level wrangler dependency. The
    // Worker now explicitly falls back to ASSETS for unmatched GET routes
    // (see the catch-all in src/index.ts) instead of relying on wrangler to
    // route non-API paths to assets automatically.
    "run_worker_first": true
  },

  "routes": [
    { "pattern": "monpass.hide23.link", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monpass-db",
      "database_id": "c5e14a76-691a-45f6-8406-453c1312678b",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "DOMAIN": "monpass.hide23.link",
    "ISSUE_START_DATE": "2000-01-01",
    "ISSUE_END_DATE": "2099-12-31",
    "LOGIN_MAX_FAILURES": "10",
    "LOGIN_LOCKOUT_MINUTES": "30",
    "MAX_TICKETS": "5"
  },

  "env": {
    "staging": {
      "name": "monpassc-staging",
      "routes": [
        { "pattern": "monpass-staging.hide23.link", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "monpass-db-staging",
          "database_id": "419d2129-0d04-4f09-9a34-5a82094351f5",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "DOMAIN": "monpass-staging.hide23.link",
        "ISSUE_START_DATE": "2000-01-01",
        "ISSUE_END_DATE": "2099-12-31",
        "LOGIN_MAX_FAILURES": "10",
        "LOGIN_LOCKOUT_MINUTES": "30",
        "MAX_TICKETS": "5"
      }
    }
  }

  // secrets (set via `wrangler secret put`, not committed):
  //   JWT_SECRET
  //   ADMIN_ID
  //   ADMIN_PASSWORD
}
